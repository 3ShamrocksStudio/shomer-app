/* SH✡MER — English permission texts (same as the Info.plist base values) */
"CFBundleDisplayName" = "SHOMER";
"NSLocationWhenInUseUsageDescription" = "SH✡MER uses your location to attach it to an SOS, to share it with the people in My Shomers when you turn sharing on, and to show safety events near you.";
"NSLocationAlwaysAndWhenInUseUsageDescription" = "With \"Always\", SH✡MER keeps sharing your location with the people in My Shomers, and can still send your SOS, when the app is in the background or your phone is locked. It only runs while location sharing is on, and you can pause it at any time.";
"NSContactsUsageDescription" = "SH✡MER opens your contacts only when you pick someone to invite to My Shomers. Only the name and number you pick are used.";
"NSCameraUsageDescription" = "SH✡MER uses the camera only for features you turn on: the theft-protection selfie and photos you add to a report or alert.";
"NSMicrophoneUsageDescription" = "SH✡MER uses the microphone only during a fake-call check-in, so you can answer by voice. You can type instead.";
"NSSpeechRecognitionUsageDescription" = "Speech recognition lets you answer a SH✡MER fake-call check-in by voice. You can type instead.";
"NSMotionUsageDescription" = "SH✡MER uses motion data for Shake-to-SOS: hard shaking starts an SOS countdown that you can cancel.";
